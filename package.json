{
  "name": "@nuup/offline-kit",
  "version": "0.2.0",
  "description": "Offline-first toolkit for React Native/Expo apps: SQLite migrations, bidirectional sync engine, and query/store abstraction.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./adapters/expo-sqlite": {
      "types": "./dist/adapters/expo-sqlite.d.ts",
      "default": "./dist/adapters/expo-sqlite.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "default": "./dist/sync/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "expo",
    "sqlite",
    "offline-first",
    "sync",
    "migrations"
  ],
  "peerDependencies": {
    "expo-sqlite": ">=13"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "verify:dist": "npm run build && git diff --exit-code -- dist",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "better-sqlite3": "^13.0.2",
    "jest": "^29.7.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/__tests__/helpers/",
      "/__tests__/types/"
    ]
  }
}
